  "TileLang Flash Attention Pattern": {
    "prefix": "tl-attention",
    "body": [
      "@tilelang.jit(out_idx=[-1])",
      "def flash_attention(batch, heads, seq_len, head_dim, block_M, block_N, dtype=T.float16):",
      "    @T.prim_func",
      "    def attn(",
      "        Q: T.Tensor((batch, heads, seq_len, head_dim), dtype),",
      "        K: T.Tensor((batch, heads, seq_len, head_dim), dtype),",
      "        V: T.Tensor((batch, heads, seq_len, head_dim), dtype),",
      "        O: T.Tensor((batch, heads, seq_len, head_dim), dtype),",
      "    ):",
      "        with T.Kernel(T.ceildiv(seq_len, block_M), heads, batch, threads=128) as (bx, by, bz):",
      "            Q_shared = T.alloc_shared((block_M, head_dim), dtype)",
      "            K_shared = T.alloc_shared((block_N, head_dim), dtype)",
      "            V_shared = T.alloc_shared((block_N, head_dim), dtype)",
      "            O_local = T.alloc_fragment((block_M, head_dim), T.float32)",
      "            score = T.alloc_fragment((block_M, block_N), T.float32)",
      "",
      "            T.clear(O_local)",
      "            T.copy(Q[bz, by, bx * block_M, 0], Q_shared)",
      "            for kv in T.Pipelined(T.ceildiv(seq_len, block_N), num_stages=2):",
      "                T.copy(K[bz, by, kv * block_N, 0], K_shared)",
      "                T.copy(V[bz, by, kv * block_N, 0], V_shared)",
      "                T.clear(score)",
      "                T.gemm(Q_shared, K_shared, score)  # Q @ K^T",
      "                # softmax + accumulate would go here",
      "                T.gemm(score, V_shared, O_local)  # score @ V",
      "",
      "            T.copy(O_local, O[bz, by, bx * block_M, 0])",
      "",
      "    return attn"
    ],
    "description": "Flash Attention kernel template (simplified)"
  }
