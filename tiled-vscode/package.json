{
  "name": "vscode-tiled",
  "displayName": "tiled (TileLang)",
  "description": "Language support for TileLang DSL — completions, hover docs, diagnostics, and snippets",
  "version": "1.2.1",
  "publisher": "tile-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/love1angel/tiled.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "tilelang",
    "tiled",
    "gpu",
    "cuda",
    "kernel",
    "dsl"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "TileLang (tiled)",
      "properties": {
        "tiled.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the tiled language server executable. If empty, uses 'tiled' from PATH or the bundled server."
        },
        "tiled.server.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter to use for the language server."
        },
        "tiled.server.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments passed to the tiled server."
        },
        "tiled.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the tiled server."
        },
        "tiled.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the tiled language server."
        }
      }
    },
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/tilelang.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run bundle -- --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.3.0"
  }
}
